# Database
DATABASE_URL=postgresql+asyncpg://jobtracker:jobtracker@localhost:5433/jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=jobtracker
POSTGRES_DB=jobtracker

# Redis
REDIS_URL=redis://localhost:6379/0

# Embedding model (default: BAAI/bge-small-en-v1.5)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=64

# Matching thresholds
MATCH_SCORE_THRESHOLD=0.65
NOTIFY_SCORE_THRESHOLD=0.75

# Notifications (Phase 3)
DISCORD_WEBHOOK_URL=

# Metrics
METRICS_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Grafana
GRAFANA_PASSWORD=admin
